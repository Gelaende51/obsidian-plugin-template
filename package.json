{
	"name": "my-plugin",
	"version": "0.1.0",
	"description": "One sentence, no marketing register, ending in a full stop.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && npm run lint && npm run check:lang && npm run check:listing && node esbuild.config.mjs production",
		"lint": "eslint src",
		"check:lang": "node scripts/check-translations.mjs",
		"check:minapp": "node scripts/check-minapp.mjs",
		"check:docs": "node scripts/check-links.mjs && node scripts/check-docs-shape.mjs",
		"check:listing": "obsidian-check-listing",
		"tags": "obsidian-listing-tags",
		"newlocale": "node scripts/newlocale.mjs",
		"stamp": "node scripts/i18n-stamp.mjs",
		"labels": "node scripts/obsidian-labels.mjs",
		"preflight": "bash scripts/preflight.sh",
		"release": "node scripts/release.mjs",
		"release:review": "node scripts/release-review.mjs",
		"publish": "node scripts/publish.mjs",
		"init": "node scripts/init.mjs"
	},
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"development-template": "https://codeload.github.com/Gelaende51/development-template/tar.gz/refs/tags/v1.2.0",
		"electron-template": "https://codeload.github.com/Gelaende51/electron-template/tar.gz/refs/tags/v0.14.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"obsidian-toolkit": "https://codeload.github.com/Gelaende51/obsidian-toolkit/tar.gz/refs/tags/v0.10.1",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.67.0"
	}
}
